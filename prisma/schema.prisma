generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Client {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  phoneNumber          String               @unique
  email                String?
  lastActive           DateTime             @default(now())
  lastMessage          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  type                 String               @default("Client")
  plan                 Plan                 @default(FREE)
  dailyMessageCount    Int                  @default(0)
  lastMessageResetDate DateTime             @default(now())

  // Relations
  messages             Message[]
  searchHistory        SearchHistory[]
  userMessageHistory   UserMessageHistory[]
  dailyMessageHistory  DailyMessageUsage[]

  // many-to-many through join model
  campaigns            ClientCampaign[]
}

model DailyMessageUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String   @db.ObjectId
  client    Client   @relation(fields: [clientId], references: [id])
  date      DateTime @default(now())
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([clientId, date])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model DailyMessageStat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime @unique
  count     Int
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  clientId  String   @db.ObjectId
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  whatsappMessageId String?        @unique
  status            MessageStatus? @default(RECEIVED)
  sentAt            DateTime?
  @@index([status])
  @@index([isBot])
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

model QAPair {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  category  String   @default("general")
  language  String   @default("en")
  isActive  Boolean  @default(true)
  tags      String[]
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([language])
  @@index([isActive])
}

model Campaign {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       String
  status     String
  audience   String
  sentCount  Int       @default(0)
  message    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSentAt DateTime?

  // many-to-many through join model
  clients    ClientCampaign[]
  templates  CampaignTemplate[]
}

model Template {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  content   String
  category  String
  variables String[]
  language  String   @default("en")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // many-to-many through join model
  campaigns CampaignTemplate[]

  @@unique([name, language])
  @@index([category])
  @@index([isActive])
}

// ---------------------------
// JOIN MODELS for many-to-many
// ---------------------------

model ClientCampaign {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId   String   @db.ObjectId
  campaignId String   @db.ObjectId

  client     Client   @relation(fields: [clientId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([clientId, campaignId])
}

model CampaignTemplate {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  templateId String   @db.ObjectId

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  template   Template @relation(fields: [templateId], references: [id])

  @@unique([campaignId, templateId])
}

model Property {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Float
  currency    String         @default("SAR")
  type        PropertyType
  status      PropertyStatus @default(AVAILABLE)
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  location    String
  address     String
  city        String
  country     String         @default("UAE")
  latitude    Float?
  longitude   Float?
  images      String[]
  features    String[]
  amenities   String[]
  yearBuilt   Int?
  parking     Int?
  furnished   Boolean        @default(false)
  petFriendly Boolean        @default(false)
  utilities   String?
  contactInfo String?
  agentId     String?        @db.ObjectId
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([city])
  @@index([price])
  @@index([isActive])
  @@index([isFeatured])
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  STUDIO
  OFFICE
  SHOP
  WAREHOUSE
  LAND
  BUILDING
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
  RESERVED
  OFF_MARKET
}

model SearchHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId     String   @db.ObjectId
  query        Json
  propertyId   String?  @db.ObjectId
  propertyName String?
  createdAt    DateTime @default(now())

  client       Client   @relation(fields: [clientId], references: [id])
}

model UserMessageHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId     String   @db.ObjectId
  message      String
  responseType String
  llmResponse  String?
  createdAt    DateTime @default(now())

  client       Client   @relation(fields: [clientId], references: [id])
}
